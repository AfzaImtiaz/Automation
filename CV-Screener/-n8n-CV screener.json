      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const groqResponse = $input.first().json;\nconst rawText = groqResponse.choices[0].message.content;\n\n// Clean accidental markdown fences\nconst cleaned = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet screening;\ntry {\n  screening = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Groq returned invalid JSON: ' + rawText);\n}\n\nconst prev = $('Code in JavaScript').first().json;\n\nreturn [{\n  json: {\n    ...prev,\n    ai_score: screening.score,\n    ai_strengths: screening.strengths,\n    ai_gaps: screening.gaps,\n    ai_recommendation: screening.recommendation,\n  }\n}];"
      },
