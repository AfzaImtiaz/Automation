        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a senior recruiter screening CVs for a {{ $json.role }} role. Candidate has {{ $json.experience_years }} years of experience. Here is their CV in base64: {{ $json.cv_base64 }} Respond ONLY with valid JSON, no markdown, no explanation. Keys: score (int 1-10), strengths (string 2-3 sentences), gaps (string 2-3 sentences), recommendation (exactly: Strong Yes, Yes, or No).\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
